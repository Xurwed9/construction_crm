# FastAPI Construction CRM — Environment Variables
# Скопируйте этот файл в .env и заполните свои значения

APP_NAME="Construction CRM"
APP_VERSION="0.1.0"
DEBUG=true

# База данных (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/construction_crm

# Безопасность
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Логирование
LOG_LEVEL=INFO
